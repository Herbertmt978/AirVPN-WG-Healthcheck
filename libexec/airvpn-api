#!/usr/bin/env python3
"""Validate AirVPN API responses and select a deterministic server."""

import argparse
import base64
import binascii
from dataclasses import dataclass, field
from decimal import Decimal, InvalidOperation
import hmac
import ipaddress
import json
import re
import sys
import urllib.error
import urllib.parse
import urllib.request


DEFAULT_STATUS_URL = "https://airvpn.org/api/status/?format=json"
DEFAULT_TIMEOUT = 20.0
MAX_TIMEOUT = 60.0
MAX_JSON_BYTES = 4 * 1024 * 1024
MAX_SERVERS = 1000
MAX_NUMERIC_TEXT_CHARS = 64
MAX_NUMERIC_MAGNITUDE = Decimal("1000000000")
MAX_NUMERIC_EXPONENT = 9
MAX_NUMERIC_SCALE = 12
MAX_NUMERIC_OUTPUT_CHARS = 64
MAX_DISPLAY_FIELD_CHARS = 256
MAX_PROFILE_BYTES = 64 * 1024
MAX_PROFILE_LINES = 64
MAX_PROFILE_LINE_BYTES = 1024
_GENERATED_PROFILE_HEADER = (
    "# Generated by wg-healthcheck from validated AirVPN API data."
)
_TSV_SEPARATORS = re.compile(r"[\t\r\n]+")
_COUNTRY_SEPARATORS = re.compile(r"[\s,]+")
_COUNTRY_CODE = re.compile(r"[A-Za-z]{2}\Z")
_INTERFACE_FIELDS = frozenset(("Address", "PrivateKey", "MTU", "DNS", "Table"))
_PEER_FIELDS = frozenset(
    ("PublicKey", "PresharedKey", "Endpoint", "AllowedIPs", "PersistentKeepalive")
)


class AirVPNAPIError(ValueError):
    """Expected invalid input or external-boundary failure."""


class NoCandidateError(AirVPNAPIError):
    """Raised when a valid status response has no eligible server."""


@dataclass(frozen=True)
class WireGuardProfile:
    """Validated WireGuard profile data with key material omitted from repr."""

    address: ipaddress.IPv4Interface
    private_key: str = field(repr=False)
    mtu: int
    dns: tuple[str, ...]
    table: str | None
    public_key: str = field(repr=False)
    preshared_key: str = field(repr=False)
    endpoint: str
    allowed_ips: str
    persistent_keepalive: int


def _validate_port(value):
    if isinstance(value, bool):
        raise AirVPNAPIError("port must be an integer between 1 and 65535")

    if isinstance(value, int):
        port = value
    elif isinstance(value, str) and value.strip().isdigit():
        try:
            port = int(value.strip())
        except (ValueError, OverflowError) as exc:
            raise AirVPNAPIError(
                "port must be an integer between 1 and 65535"
            ) from exc
    else:
        raise AirVPNAPIError("port must be an integer between 1 and 65535")

    if not 1 <= port <= 65535:
        raise AirVPNAPIError("port must be between 1 and 65535")
    return port


def parse_endpoint_ip(endpoint):
    """Return the normalized IP from an IPv4 or bracketed IPv6 endpoint."""

    if not isinstance(endpoint, str) or not endpoint.strip():
        raise AirVPNAPIError("endpoint must be non-empty text in IP:port form")

    endpoint = endpoint.strip()
    if endpoint.startswith("["):
        closing_bracket = endpoint.find("]")
        if closing_bracket < 0 or endpoint[closing_bracket + 1 : closing_bracket + 2] != ":":
            raise AirVPNAPIError("IPv6 endpoint must use [address]:port form")
        host = endpoint[1:closing_bracket]
        port_text = endpoint[closing_bracket + 2 :]
        if "]" in port_text or ":" in port_text:
            raise AirVPNAPIError("IPv6 endpoint must use [address]:port form")
        expected_version = 6
    else:
        if endpoint.count(":") != 1:
            raise AirVPNAPIError("IPv4 endpoint must use address:port form")
        host, port_text = endpoint.rsplit(":", 1)
        expected_version = 4

    _validate_port(port_text)
    try:
        address = ipaddress.ip_address(host)
    except ValueError as exc:
        raise AirVPNAPIError("endpoint host must be a valid IP address") from exc

    if address.version != expected_version:
        family = "IPv6" if expected_version == 6 else "IPv4"
        raise AirVPNAPIError(f"endpoint must contain a valid {family} address")
    return str(address)


def _profile_lines(payload):
    if not isinstance(payload, bytes):
        raise AirVPNAPIError("WireGuard profile payload must be bytes")
    if len(payload) > MAX_PROFILE_BYTES:
        raise AirVPNAPIError(
            f"WireGuard profile exceeds {MAX_PROFILE_BYTES} bytes"
        )

    normalized = payload.replace(b"\r\n", b"\n")
    if b"\r" in normalized:
        raise AirVPNAPIError("WireGuard profile contains a bare carriage return")
    if any((byte < 32 and byte != 10) or byte == 127 for byte in normalized):
        raise AirVPNAPIError("WireGuard profile contains a control byte")

    raw_lines = normalized.split(b"\n")
    if normalized.endswith(b"\n"):
        raw_lines.pop()
    if len(raw_lines) > MAX_PROFILE_LINES:
        raise AirVPNAPIError(
            f"WireGuard profile exceeds {MAX_PROFILE_LINES} lines"
        )
    if any(len(line) > MAX_PROFILE_LINE_BYTES for line in raw_lines):
        raise AirVPNAPIError(
            f"WireGuard profile line exceeds {MAX_PROFILE_LINE_BYTES} bytes"
        )

    try:
        lines = [line.decode("utf-8") for line in raw_lines]
    except UnicodeDecodeError as exc:
        raise AirVPNAPIError("WireGuard profile must be UTF-8") from exc
    if any(
        not character.isprintable()
        for line in lines
        for character in line
    ):
        raise AirVPNAPIError("WireGuard profile contains a control character")
    return lines


def _wireguard_key(value, field_name):
    try:
        decoded = base64.b64decode(value, validate=True)
    except (binascii.Error, ValueError) as exc:
        raise AirVPNAPIError(
            f"WireGuard profile {field_name} must be a canonical key"
        ) from exc
    if (
        len(decoded) != 32
        or not any(decoded)
        or base64.b64encode(decoded).decode("ascii") != value
    ):
        raise AirVPNAPIError(
            f"WireGuard profile {field_name} must be a canonical nonzero key"
        )
    return value


def _profile_address(value):
    try:
        address = ipaddress.ip_interface(value)
    except ValueError as exc:
        raise AirVPNAPIError(
            "WireGuard profile Address must be one canonical IPv4 /32"
        ) from exc
    if (
        not isinstance(address, ipaddress.IPv4Interface)
        or address.network.prefixlen != 32
        or str(address) != value
    ):
        raise AirVPNAPIError(
            "WireGuard profile Address must be one canonical IPv4 /32"
        )
    return address


def _profile_dns(value):
    values = value.split(",")
    if not values:
        raise AirVPNAPIError("WireGuard profile DNS must contain numeric addresses")

    normalized = []
    for item in values:
        item = item.strip()
        if not item or "%" in item:
            raise AirVPNAPIError(
                "WireGuard profile DNS must contain numeric addresses"
            )
        try:
            address = ipaddress.ip_address(item)
        except ValueError as exc:
            raise AirVPNAPIError(
                "WireGuard profile DNS must contain numeric addresses"
            ) from exc
        if str(address) != item:
            raise AirVPNAPIError(
                "WireGuard profile DNS must contain canonical numeric addresses"
            )
        normalized.append(str(address))
    return tuple(normalized)


def _profile_table(value):
    if value in ("auto", "off"):
        return value
    if not re.fullmatch(r"[0-9]+", value) or len(value) > 10:
        raise AirVPNAPIError("WireGuard profile Table must be auto, off, or numeric")
    table = int(value)
    if not 1 <= table <= 4294967295 or str(table) != value:
        raise AirVPNAPIError("WireGuard profile Table must be auto, off, or numeric")
    return value


def _profile_endpoint(value):
    if not isinstance(value, str) or value.count(":") != 1:
        raise AirVPNAPIError(
            "WireGuard profile Endpoint must be a canonical IPv4 endpoint"
        )
    host, port_text = value.rsplit(":", 1)
    try:
        address = ipaddress.ip_address(host)
    except ValueError as exc:
        raise AirVPNAPIError(
            "WireGuard profile Endpoint must be a canonical IPv4 endpoint"
        ) from exc
    if not isinstance(address, ipaddress.IPv4Address):
        raise AirVPNAPIError(
            "WireGuard profile Endpoint must be a canonical IPv4 endpoint"
        )
    port = _validate_port(port_text)
    canonical = f"{address}:{port}"
    if canonical != value:
        raise AirVPNAPIError(
            "WireGuard profile Endpoint must be a canonical IPv4 endpoint"
        )
    return canonical


def parse_wireguard_profile(
    payload: bytes, *, expected_endpoint: str | None = None
) -> WireGuardProfile:
    """Strictly parse untrusted WireGuard profile bytes into validated data."""

    fields = {"Interface": {}, "Peer": {}}
    sections = []
    section = None
    for line_number, line in enumerate(_profile_lines(payload), start=1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue

        if stripped in ("[Interface]", "[Peer]"):
            section_name = stripped[1:-1]
            expected = "Interface" if not sections else "Peer"
            if section_name != expected or section_name in sections:
                raise AirVPNAPIError(
                    "WireGuard profile must contain one Interface then one Peer"
                )
            sections.append(section_name)
            section = section_name
            continue
        if stripped.startswith("[") or stripped.endswith("]"):
            raise AirVPNAPIError("WireGuard profile contains an unknown section")
        if section is None:
            raise AirVPNAPIError(
                f"WireGuard profile directive before Interface on line {line_number}"
            )
        if "=" not in stripped:
            raise AirVPNAPIError(
                f"WireGuard profile has malformed directive on line {line_number}"
            )

        name, value = (part.strip() for part in stripped.split("=", 1))
        allowed = _INTERFACE_FIELDS if section == "Interface" else _PEER_FIELDS
        if not name or not value or name not in allowed:
            raise AirVPNAPIError(
                f"WireGuard profile contains a disallowed directive on line {line_number}"
            )
        if name in fields[section]:
            raise AirVPNAPIError(
                f"WireGuard profile contains a duplicate directive on line {line_number}"
            )
        fields[section][name] = value

    if sections != ["Interface", "Peer"]:
        raise AirVPNAPIError(
            "WireGuard profile must contain one Interface then one Peer"
        )
    interface = fields["Interface"]
    peer = fields["Peer"]
    if not {"Address", "PrivateKey", "MTU"}.issubset(interface):
        raise AirVPNAPIError("WireGuard profile is missing an Interface directive")
    if not _PEER_FIELDS.issubset(peer):
        raise AirVPNAPIError("WireGuard profile is missing a Peer directive")

    if interface["MTU"] != "1320":
        raise AirVPNAPIError("WireGuard profile MTU must be exactly 1320")
    if peer["PersistentKeepalive"] != "15":
        raise AirVPNAPIError(
            "WireGuard profile PersistentKeepalive must be exactly 15"
        )
    if peer["AllowedIPs"] != "0.0.0.0/0":
        raise AirVPNAPIError(
            "WireGuard profile AllowedIPs must be exactly 0.0.0.0/0"
        )

    endpoint = _profile_endpoint(peer["Endpoint"])
    if expected_endpoint is not None:
        if endpoint != _profile_endpoint(expected_endpoint):
            raise AirVPNAPIError(
                "WireGuard profile Endpoint does not match the expected endpoint"
            )

    return WireGuardProfile(
        address=_profile_address(interface["Address"]),
        private_key=_wireguard_key(interface["PrivateKey"], "PrivateKey"),
        mtu=1320,
        dns=_profile_dns(interface["DNS"]) if "DNS" in interface else (),
        table=_profile_table(interface["Table"]) if "Table" in interface else None,
        public_key=_wireguard_key(peer["PublicKey"], "PublicKey"),
        preshared_key=_wireguard_key(peer["PresharedKey"], "PresharedKey"),
        endpoint=endpoint,
        allowed_ips="0.0.0.0/0",
        persistent_keepalive=15,
    )


def render_wireguard_profile(profile: WireGuardProfile) -> bytes:
    """Render validated profile data in the canonical managed-profile format."""

    lines = [
        _GENERATED_PROFILE_HEADER,
        "[Interface]",
        f"Address = {profile.address}",
        f"PrivateKey = {profile.private_key}",
        f"MTU = {profile.mtu}",
    ]
    if profile.dns:
        lines.append(f"DNS = {', '.join(profile.dns)}")
    if profile.table is not None:
        lines.append(f"Table = {profile.table}")
    lines.extend(
        (
            "",
            "[Peer]",
            f"PublicKey = {profile.public_key}",
            f"PresharedKey = {profile.preshared_key}",
            f"Endpoint = {profile.endpoint}",
            f"AllowedIPs = {profile.allowed_ips}",
            f"PersistentKeepalive = {profile.persistent_keepalive}",
        )
    )
    rendered = ("\n".join(lines) + "\n").encode("utf-8")
    parse_wireguard_profile(rendered)
    return rendered


def profiles_have_same_identity(
    expected: WireGuardProfile, candidate: WireGuardProfile
) -> bool:
    """Compare the fixed private key and address without exposing key material."""

    private_key_matches = hmac.compare_digest(
        expected.private_key,
        candidate.private_key,
    )
    return private_key_matches and expected.address == candidate.address


def _compose_pinned_profile(
    current: WireGuardProfile, generated: WireGuardProfile
) -> WireGuardProfile:
    """Pin current identity and local Table around newly generated profile data."""

    if not profiles_have_same_identity(current, generated):
        raise AirVPNAPIError("generated WireGuard profile identity does not match")
    table = _profile_table(current.table) if current.table is not None else None
    return WireGuardProfile(
        address=current.address,
        private_key=current.private_key,
        mtu=generated.mtu,
        dns=generated.dns,
        table=table,
        public_key=generated.public_key,
        preshared_key=generated.preshared_key,
        endpoint=generated.endpoint,
        allowed_ips=generated.allowed_ips,
        persistent_keepalive=generated.persistent_keepalive,
    )


def validate_status_payload(data):
    """Validate the top-level AirVPN status response and return its servers."""

    if not isinstance(data, dict):
        raise AirVPNAPIError("status payload must be an object")
    if data.get("result") != "ok":
        raise AirVPNAPIError("status result must be 'ok'")

    servers = data.get("servers")
    if not isinstance(servers, list):
        raise AirVPNAPIError("status servers must be a list")
    if len(servers) > MAX_SERVERS:
        raise AirVPNAPIError(
            f"status payload contains more than {MAX_SERVERS} servers"
        )
    for index, server in enumerate(servers):
        if not isinstance(server, dict):
            raise AirVPNAPIError(f"status server {index} must be an object")
    return servers


def _sanitize_tsv(value, *, default=""):
    if not isinstance(value, str):
        raise AirVPNAPIError("TSV display values must be text")
    sanitized = _TSV_SEPARATORS.sub(" ", value).strip()
    display = sanitized or default
    if len(display) > MAX_DISPLAY_FIELD_CHARS:
        raise AirVPNAPIError(
            f"display field exceeds {MAX_DISPLAY_FIELD_CHARS} characters"
        )
    return display


def _server_text(server, index, field, *, default=""):
    value = server.get(field)
    if value is None:
        return default
    if not isinstance(value, str):
        raise AirVPNAPIError(
            f"status server {index} field {field} must be text"
        )
    return _sanitize_tsv(value, default=default)


def _validate_decimal_bounds(number, context):
    if not number.is_finite() or number < 0:
        raise AirVPNAPIError(f"{context} must be a non-negative finite number")

    exponent = number.as_tuple().exponent
    if exponent > MAX_NUMERIC_EXPONENT or exponent < -MAX_NUMERIC_SCALE:
        raise AirVPNAPIError(f"{context} has an unreasonable exponent or scale")
    if number > MAX_NUMERIC_MAGNITUDE:
        raise AirVPNAPIError(
            f"{context} magnitude exceeds {MAX_NUMERIC_MAGNITUDE}"
        )


def _decimal_field(server, index, field, *, integer=False):
    value = server.get(field)
    if isinstance(value, bool) or value is None:
        raise AirVPNAPIError(
            f"status server {index} field {field} must be numeric"
        )
    if not isinstance(value, (int, float, str, Decimal)):
        raise AirVPNAPIError(
            f"status server {index} field {field} must be numeric"
        )

    try:
        numeric_text = str(value).strip()
    except (ValueError, OverflowError) as exc:
        raise AirVPNAPIError(
            f"status server {index} field {field} must be numeric"
        ) from exc
    if len(numeric_text) > MAX_NUMERIC_TEXT_CHARS:
        raise AirVPNAPIError(
            f"status server {index} field {field} must be at most "
            f"{MAX_NUMERIC_TEXT_CHARS} characters"
        )

    try:
        number = Decimal(numeric_text)
    except (InvalidOperation, ValueError) as exc:
        raise AirVPNAPIError(
            f"status server {index} field {field} must be numeric"
        ) from exc

    context = f"status server {index} field {field}"
    _validate_decimal_bounds(number, context)
    if integer and number != number.to_integral_value():
        raise AirVPNAPIError(f"{context} must be an integer")
    return number


def _format_decimal(value):
    _validate_decimal_bounds(value, "numeric output")
    if value == value.to_integral_value():
        formatted = format(value.quantize(Decimal("1")), "f")
    else:
        formatted = format(value.normalize(), "f")
    if len(formatted) > MAX_NUMERIC_OUTPUT_CHARS:
        raise AirVPNAPIError(
            f"numeric output exceeds {MAX_NUMERIC_OUTPUT_CHARS} characters"
        )
    return formatted


def _normalize_allowed_countries(allowed_countries):
    if allowed_countries is None:
        return []
    if isinstance(allowed_countries, str):
        values = [
            value
            for value in _COUNTRY_SEPARATORS.split(allowed_countries.strip())
            if value
        ]
    else:
        try:
            values = list(allowed_countries)
        except TypeError as exc:
            raise AirVPNAPIError("allowed countries must be text values") from exc

    normalized = []
    seen = set()
    for value in values:
        if not isinstance(value, str) or not value.strip():
            raise AirVPNAPIError(
                "allowed countries must be non-empty text values"
            )
        country = value.strip().upper()
        if country not in seen:
            normalized.append(country)
            seen.add(country)
    return normalized


def _current_ip(current_endpoint):
    if current_endpoint is None or current_endpoint == "":
        return None
    if not isinstance(current_endpoint, str):
        raise AirVPNAPIError("current endpoint must be text")

    stripped = current_endpoint.strip()
    if not stripped:
        return None
    try:
        return ipaddress.ip_address(parse_endpoint_ip(stripped))
    except ValueError as endpoint_error:
        try:
            return ipaddress.ip_address(stripped)
        except ValueError:
            raise AirVPNAPIError(
                "current endpoint must be an IP or IP:port endpoint"
            ) from endpoint_error


def _server_entry_ips(server, index):
    entry_ips = []
    for family, version in (("v4", 4), ("v6", 6)):
        for entry_number in range(1, 5):
            field = f"ip_{family}_in{entry_number}"
            value = server.get(field)
            if value is None or value == "":
                continue
            if not isinstance(value, str):
                raise AirVPNAPIError(
                    f"status server {index} field {field} must be text"
                )
            try:
                address = ipaddress.ip_address(value.strip())
            except ValueError as exc:
                raise AirVPNAPIError(
                    f"status server {index} field {field} must be a valid IP address"
                ) from exc
            if address.version != version:
                raise AirVPNAPIError(
                    f"status server {index} field {field} has the wrong IP family"
                )
            entry_ips.append((field, address))
    return entry_ips


def _country_name(server, index):
    value = server.get("country_name")
    if not isinstance(value, str):
        raise AirVPNAPIError(
            f"status server {index} field country_name must be text"
        )
    if any(
        character not in "\t\r\n" and not character.isprintable()
        for character in value
    ):
        raise AirVPNAPIError(
            f"status server {index} field country_name contains a control character"
        )
    name = _sanitize_tsv(value)
    if not name:
        raise AirVPNAPIError(
            f"status server {index} field country_name must be non-empty"
        )
    return name


def list_eligible_countries(data):
    """Return sorted TSV-ready countries with healthy IPv4 server counts."""

    countries = {}
    for index, server in enumerate(validate_status_payload(data)):
        health = server.get("health")
        if not isinstance(health, str):
            raise AirVPNAPIError(
                f"status server {index} field health must be text"
            )
        if health != "ok":
            continue

        entry_ips = _server_entry_ips(server, index)
        if not any(field == "ip_v4_in1" for field, _address in entry_ips):
            raise AirVPNAPIError(
                f"status server {index} field ip_v4_in1 must be a valid IPv4 address"
            )

        country_code = server.get("country_code")
        if not isinstance(country_code, str) or not _COUNTRY_CODE.fullmatch(
            country_code
        ):
            raise AirVPNAPIError(
                f"status server {index} field country_code must be two ASCII letters"
            )
        country_code = country_code.upper()
        country_name = _country_name(server, index)

        existing = countries.get(country_code)
        if existing is not None and existing[0] != country_name:
            raise AirVPNAPIError(
                f"status country {country_code} has conflicting names"
            )
        if existing is None:
            countries[country_code] = [country_name, 1]
        else:
            existing[1] += 1

    return [
        (country_code, countries[country_code][0], str(countries[country_code][1]))
        for country_code in sorted(countries)
    ]


def select_candidate(data, allowed_countries, port, current_endpoint):
    """Return the best server as seven TSV-ready fields, or ``None``."""

    servers = validate_status_payload(data)
    port = _validate_port(port)
    allowed = _normalize_allowed_countries(allowed_countries)
    allowed_positions = {country: index for index, country in enumerate(allowed)}
    current_ip = _current_ip(current_endpoint)

    candidates = []
    for index, server in enumerate(servers):
        health = server.get("health")
        if not isinstance(health, str):
            raise AirVPNAPIError(
                f"status server {index} field health must be text"
            )
        if health != "ok":
            continue

        country = _server_text(server, index, "country_code").upper()
        if allowed and country not in allowed_positions:
            continue

        entry_ips = _server_entry_ips(server, index)
        if current_ip is not None and any(
            address == current_ip for _field, address in entry_ips
        ):
            continue

        ipv4_in1 = next(
            (address for field, address in entry_ips if field == "ip_v4_in1"),
            None,
        )
        if ipv4_in1 is None:
            raise AirVPNAPIError(
                f"status server {index} field ip_v4_in1 must be a valid IPv4 address"
            )

        load = _decimal_field(server, index, "currentload")
        users = _decimal_field(server, index, "users", integer=True)
        bw_max = _decimal_field(server, index, "bw_max")
        name = _server_text(server, index, "public_name")
        if not name:
            name = _server_text(server, index, "name", default="unknown")
        location = _server_text(server, index, "location")

        preference_index = allowed_positions.get(country, 0)
        country_penalty = Decimal(preference_index) * Decimal("0.25")
        capacity_bonus = min(bw_max, Decimal("20000")) / Decimal("100000")
        score = load + users / Decimal("100") + country_penalty - capacity_bonus
        endpoint_ip = str(ipv4_in1)
        record = (
            name,
            f"{endpoint_ip}:{port}",
            country,
            location,
            _format_decimal(bw_max),
            _format_decimal(load),
            _format_decimal(users),
        )
        sort_key = (
            score,
            load,
            -bw_max,
            users,
            preference_index,
            name.casefold(),
            name,
            endpoint_ip,
            country,
            location,
        )
        candidates.append((sort_key, record))

    if not candidates:
        return None
    return min(candidates, key=lambda candidate: candidate[0])[1]


def validate_egress(data):
    """Validate AirVPN egress and return safe server/country display text."""

    if not isinstance(data, dict):
        raise AirVPNAPIError("egress payload must be an object")
    if data.get("result") != "ok":
        raise AirVPNAPIError("egress result must be 'ok'")
    if data.get("airvpn") is not True:
        raise AirVPNAPIError("egress airvpn must be true")

    server = data.get("server_name")
    if server is None or server == "":
        server = "unknown"
    if not isinstance(server, str):
        raise AirVPNAPIError("egress server_name must be text")

    geo = data.get("geo")
    if geo is None:
        geo = {}
    if not isinstance(geo, dict):
        raise AirVPNAPIError("egress geo must be an object")
    country = geo.get("name") or geo.get("code") or "unknown"
    if not isinstance(country, str):
        raise AirVPNAPIError("egress country must be text")

    return (
        _sanitize_tsv(server, default="unknown"),
        _sanitize_tsv(country, default="unknown"),
    )


def _validate_timeout(value):
    if isinstance(value, bool):
        raise AirVPNAPIError("timeout must be between 0 and 60 seconds")
    try:
        timeout = float(value)
    except (TypeError, ValueError, OverflowError) as exc:
        raise AirVPNAPIError("timeout must be between 0 and 60 seconds") from exc
    if not 0 < timeout <= MAX_TIMEOUT:
        raise AirVPNAPIError("timeout must be between 0 and 60 seconds")
    return timeout


def _load_json_stream(stream, source):
    payload = stream.read(MAX_JSON_BYTES + 1)
    if isinstance(payload, str):
        payload = payload.encode("utf-8")
    elif isinstance(payload, bytearray):
        payload = bytes(payload)
    elif not isinstance(payload, bytes):
        raise TypeError("JSON stream read() must return bytes or text")

    if len(payload) > MAX_JSON_BYTES:
        raise AirVPNAPIError(f"{source} exceeds {MAX_JSON_BYTES} bytes")

    try:
        decoded = payload.decode("utf-8")
        return json.loads(decoded)
    except json.JSONDecodeError:
        raise
    except ValueError as exc:
        raise AirVPNAPIError(f"invalid JSON input: {exc}") from exc


def _validate_https_url(url):
    if not isinstance(url, str) or not url:
        raise AirVPNAPIError("status URL must be HTTPS without credentials or whitespace")
    if "\\" in url or any(character.isspace() or ord(character) < 32 for character in url):
        raise AirVPNAPIError("status URL must be HTTPS without credentials or whitespace")
    try:
        parsed = urllib.parse.urlsplit(url)
        hostname = parsed.hostname
        parsed.port
    except ValueError as exc:
        raise AirVPNAPIError("status URL must be HTTPS without credentials or whitespace") from exc
    if (
        parsed.scheme.lower() != "https"
        or not hostname
        or parsed.username is not None
        or parsed.password is not None
    ):
        raise AirVPNAPIError("status URL must be HTTPS without credentials or whitespace")
    return url


class _HTTPSOnlyRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, file_pointer, code, message, headers, new_url):
        safe_url = _validate_https_url(new_url)
        return super().redirect_request(
            request, file_pointer, code, message, headers, safe_url
        )


def _fetch_json(url, timeout):
    safe_url = _validate_https_url(url)
    try:
        request = urllib.request.Request(
            safe_url, headers={"User-Agent": "wg-healthcheck/airvpn"}
        )
        opener = urllib.request.build_opener(_HTTPSOnlyRedirectHandler())
        response = opener.open(
            request, timeout=_validate_timeout(timeout)
        )
    except ValueError as exc:
        raise AirVPNAPIError(f"invalid status URL: {exc}") from exc

    with response:
        return _load_json_stream(response, "HTTP JSON response")


def _build_parser():
    parser = argparse.ArgumentParser(prog="airvpn-api")
    subparsers = parser.add_subparsers(dest="command", required=True)

    select_parser = subparsers.add_parser(
        "select", help="fetch status and print the best server"
    )
    select_parser.add_argument("--url", default=DEFAULT_STATUS_URL)
    select_parser.add_argument("--countries", default="")
    select_parser.add_argument("--port", default=1637)
    select_parser.add_argument("--current-endpoint", default="")
    select_parser.add_argument("--timeout", default=DEFAULT_TIMEOUT)

    countries_parser = subparsers.add_parser(
        "list-countries", help="list countries with healthy IPv4 servers"
    )
    countries_parser.add_argument("--url", default=DEFAULT_STATUS_URL)
    countries_parser.add_argument("--timeout", default=DEFAULT_TIMEOUT)

    subparsers.add_parser(
        "verify-egress", help="validate a whatismyip JSON document from stdin"
    )
    return parser


def _error_text(error):
    message = _TSV_SEPARATORS.sub(" ", str(error)).strip()
    if not message:
        message = error.__class__.__name__
    if len(message) > 240:
        message = message[:237] + "..."
    return message


def main(argv=None):
    args = _build_parser().parse_args(argv)
    try:
        if args.command == "select":
            data = _fetch_json(args.url, args.timeout)
            candidate = select_candidate(
                data,
                args.countries,
                args.port,
                args.current_endpoint,
            )
            if candidate is None:
                raise NoCandidateError("no eligible AirVPN server")
            print("\t".join(candidate))
        elif args.command == "list-countries":
            data = _fetch_json(args.url, args.timeout)
            for country in list_eligible_countries(data):
                print("\t".join(country))
        elif args.command == "verify-egress":
            stdin_stream = getattr(sys.stdin, "buffer", sys.stdin)
            data = _load_json_stream(stdin_stream, "stdin JSON input")
            print("\t".join(validate_egress(data)))
        return 0
    except NoCandidateError as exc:
        print(f"ERROR: {_error_text(exc)}", file=sys.stderr)
        return 3
    except (
        AirVPNAPIError,
        json.JSONDecodeError,
        UnicodeError,
        OSError,
    ) as exc:
        print(f"ERROR: {_error_text(exc)}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
